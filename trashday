#!/bin/bash
# trashday — sweep the Desktop into ~/Documents/Archive/Desktop
#
# Moves every file and folder off ~/Desktop into the dump. Never overwrites:
# a name that already exists in the dump gets a timestamp suffix instead.
# macOS bookkeeping files (.DS_Store, .localized) are left alone.
#
# Usage:
#   trashday            move everything
#   trashday -n         dry run — print what would move, touch nothing

set -u

DESKTOP="$HOME/Desktop"
DUMP="$HOME/Documents/Archive/Desktop"

dry=0
case "${1:-}" in
  -n|--dry-run) dry=1 ;;
  -h|--help)    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  "")           ;;
  *)            echo "trashday: unknown option '$1' (try --help)" >&2; exit 2 ;;
esac

[ -d "$DESKTOP" ] || { echo "trashday: no Desktop at $DESKTOP" >&2; exit 1; }
[ "$dry" -eq 1 ] || mkdir -p "$DUMP" || exit 1

shopt -s nullglob dotglob

moved=0
for path in "$DESKTOP"/*; do
  name=$(basename "$path")
  case "$name" in
    .DS_Store|.localized) continue ;;
  esac

  dest="$DUMP/$name"
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    stamp=$(date +%Y%m%d-%H%M%S)
    case "$name" in
      *.*) dest="$DUMP/${name%.*}-$stamp.${name##*.}" ;;
      *)   dest="$DUMP/$name-$stamp" ;;
    esac
    candidate="$dest"
    suffix=2
    while [ -e "$dest" ] || [ -L "$dest" ]; do
      dest="$candidate-$suffix"
      suffix=$((suffix + 1))
    done
  fi

  if [ "$dry" -eq 1 ]; then
    echo "would move: $name -> ${dest#$DUMP/}"
  else
    if mv -n -- "$path" "$dest" && [ ! -e "$path" ] && [ ! -L "$path" ]; then
      echo "moved: $name -> ${dest#$DUMP/}"
    else
      echo "trashday: failed to move $name" >&2
      continue
    fi
  fi
  moved=$((moved + 1))
done

if [ "$moved" -eq 0 ]; then
  echo "Desktop is already clean."
elif [ "$dry" -eq 1 ]; then
  echo "$moved item(s) would move into $DUMP"
else
  echo "$moved item(s) moved into $DUMP"
fi
